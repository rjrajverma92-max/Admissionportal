# =========================================================
# Multi-Institute Admission & Fees Portal Environment Variables
# =========================================================

# Firebase Web App Credentials
# Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Super Administrator Root Email
# This email grants full master access to manage all institutes, provision tenants, and impersonate portals.
VITE_SUPER_ADMIN_EMAIL=rjrajverma92@gmail.com
