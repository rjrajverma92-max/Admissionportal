rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all incoming requests
    match /{document=**} {
      allow read, write: if false;
    }

    // Release notes collection
    match /release_notes/{noteId} {
      allow read, write: if true;
    }

    // Subscription payments collection
    match /subscription_payments/{paymentId} {
      allow read, write: if true;
    }

    // Subscription overrides collection
    match /subscription_overrides/{overrideId} {
      allow read, write: if true;
    }

    // Multi-tenant institute management structure
    match /institutes/{instituteId} {
      // Allow reading, creating, updating, and deleting institute tenant config
      allow read, write: if true;

      // Subcollection: Students (Registry, admissions, status history, and certificate verify)
      match /students/{studentId} {
        allow read, write: if true;
      }

      // Subcollection: Payments (Admission fees, installments)
      match /payments/{paymentId} {
        allow read, write: if true;
      }

      // Subcollection: Expenses (Operational expenses, salaries, rent)
      match /expenses/{expenseId} {
        allow read, write: if true;
      }

      // Subcollection: Courses (Course catalog and fees)
      match /courses/{courseId} {
        allow read, write: if true;
      }

      // Subcollection: Batches (Scheduled batches)
      match /batches/{batchId} {
        allow read, write: if true;
      }

      // Subcollection: Counters (Sequential FY registration numbers)
      match /counters/{counterId} {
        allow read, write: if true;
      }

      // Subcollections: Leads and any future modules
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }
  }
}
