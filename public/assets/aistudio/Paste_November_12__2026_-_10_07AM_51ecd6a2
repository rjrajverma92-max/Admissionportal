## REGISTRATION NUMBER GENERATION

Use Firestore transaction to prevent duplicate numbers:

```typescript
async function generateRegistrationNumber(instituteId: string, regPrefix: string, admissionDate: string): Promise<string> {
  const year = new Date(admissionDate).getFullYear();
  const month = new Date(admissionDate).getMonth() + 1;
  const fyYear = month >= 4 ? year : year - 1;
  const fyKey = `${fyYear}-${String(fyYear + 1).slice(-2)}`;
  
  const counterRef = doc(db, `institutes/${instituteId}/counters/${fyKey}`);
  
  let regNumber = "";
  await runTransaction(db, async (transaction) => {
    const counterDoc = await transaction.get(counterRef);
    const currentSeq = counterDoc.exists() ? counterDoc.data().seq : 0;
    const nextSeq = currentSeq + 1;
    transaction.set(counterRef, { seq: nextSeq }, { merge: true });
    regNumber = `${regPrefix}-${fyKey}-${String(nextSeq).padStart(4, "0")}`;
  });
  
  return regNumber;
}
```

